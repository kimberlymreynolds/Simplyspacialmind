modules = ["nodejs-24", "python-base-3.13"]

[deployment]
deploymentTarget = "static"
build = ["node", "scripts/src/build-site.mjs"]
publicDir = "artifacts/simply-spacial/dist/public"

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
